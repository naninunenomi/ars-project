{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/check",
      "dest": "/api/check.js"
    },
    {
      "src": "/api/stats",
      "dest": "/api/stats.js"
    },
    {
      "src": "/api/learn",
      "dest": "/api/learn.js"
    },
    {
      "src": "/api/models",
      "dest": "/api/models.js"
    },
    {
      "src": "/api/version",
      "dest": "/api/version.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/learn",
      "schedule": "0 0 * * *"
    }
  ]
}
