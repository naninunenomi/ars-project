{
  "version": 2,
  "name": "ars-project",
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "env": {
    "KV_REST_API_URL": "",
    "KV_REST_API_TOKEN": "",
    "BYPASS_DB": "true"
  }
}
