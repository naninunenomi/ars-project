{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/check", "dest": "/api/check.js" },
    { "src": "/api/stats", "dest": "/api/stats.js" },
    { "src": "/api/scout", "dest": "/api/scout.js" },
    { "src": "/api/watcher", "dest": "/api/watcher.js" },
    { "src": "/", "dest": "/public/index.html" }
  ],
  "crons": [
    {
      "path": "/api/scout",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/watcher",
      "schedule": "0 4 * * *"
    }
  ]
}
