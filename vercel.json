{
  "version": 2,
  "name": "ars-project",
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node", "config": { "maxDuration": 60 } },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.json", "use": "@vercel/static" },
    { "src": "llms.txt", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
